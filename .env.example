# Kapta license server: copy to .env and fill every value.
NODE_ENV=production
PORT=3000
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=kapta_db
# New random secret (e.g. openssl rand -hex 48).
JWT_SECRET=
JWT_EXPIRATION=30d
# Super admin created at first start (never stored in the mobile app).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Web build of the app only (the Android app needs none): exact origins, comma separated
CORS_ORIGINS=
